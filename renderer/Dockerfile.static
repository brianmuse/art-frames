FROM python:3.12-slim@sha256:12316debbfb86890f6b2d825820612741ba527ad5a44e3902759141d572bfe8f
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 HOME=/tmp
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends libpango-1.0-0 libpangoft2-1.0-0 libharfbuzz-subset0 fonts-dejavu-core \
    && rm -rf /var/lib/apt/lists/*
COPY renderer/requirements.static.lock ./requirements.lock
RUN pip install --no-cache-dir --require-hashes -r requirements.lock \
    && mkdir -p /run/dayframe-renderer \
    && chown 10001:10001 /run/dayframe-renderer && chmod 770 /run/dayframe-renderer
COPY renderer/static_server.py renderer/static_capture.py renderer/pipe.py ./renderer/
COPY art_frames/ipc.py ./art_frames/ipc.py
USER 10001:10001
CMD ["python", "-m", "renderer.static_server"]
