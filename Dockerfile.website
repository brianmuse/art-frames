FROM node:24-slim@sha256:55fb5f5a527ea2c5c4a95f963e48ef90aa38c7b346054fdc8ee9957a2b55d205 AS build
ENV ASTRO_TELEMETRY_DISABLED=1 DAYFRAME_SITE_MODE=service
WORKDIR /website
COPY website/package*.json ./
RUN npm ci
COPY website ./
RUN npm run build

FROM node:24-slim@sha256:55fb5f5a527ea2c5c4a95f963e48ef90aa38c7b346054fdc8ee9957a2b55d205
ENV NODE_ENV=production ASTRO_TELEMETRY_DISABLED=1
WORKDIR /website
COPY --from=build /website/dist ./dist
COPY --from=build /website/node_modules ./node_modules
COPY website/server.mjs ./server.mjs
RUN mkdir -p /run/dayframe-site && chown 10001:10001 /run/dayframe-site && chmod 770 /run/dayframe-site
# Installed layouts read /site-config and write /site-state. An empty named volume takes these owners.
RUN mkdir -p /site-config /site-state && chown 10001:10001 /site-state && chmod 700 /site-state
USER 10001:10001
# ulimit -u counts every process and thread of this user ID on the whole host, including
# the other Art Frames containers, so 64 could stop Node from starting. 4096 is a host-wide
# ceiling for this user ID, not a per-container limit.
CMD ["bash", "-e", "-c", "ulimit -u 4096; ulimit -c 0; exec node --max-old-space-size=128 server.mjs"]
