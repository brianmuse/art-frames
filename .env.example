# Container UID/GID own only Dayframe's data and secret files.
DAYFRAME_UID=10001
DAYFRAME_GID=10001
# HTTP stays on host loopback. Use an SSH tunnel or an HTTPS reverse proxy.
DAYFRAME_PORT=8765
DAYFRAME_HOSTS=localhost,127.0.0.1,[::1]
# Set to 1 behind an HTTPS reverse proxy, and add its hostname to DAYFRAME_HOSTS.
DAYFRAME_SECURE_COOKIES=0
